# ================================
# IT Ticketing System - Environment
# ================================
# IMPORTANT: Copy this file to .env.local for local development
# DO NOT commit .env.local to version control

# ================================
# Database Configuration
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticketing
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ================================
# JWT Configuration (P0-1 Security)
# ================================
# Generate a secure secret: openssl rand -base64 48
# Secret must be at least 32 characters and NOT contain weak patterns:
# - No: "change", "secret", "password", "123456", "test"
# - Yes: Use random characters, numbers, and special symbols
SECURITY_JWT_SECRET=change-this-to-a-secure-random-32-chars-minimum-key

# ================================
# Application Settings
# ================================
APP_PORT=8080
APP_ENV=development

# ================================
# Email Configuration (Optional)
# ================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
